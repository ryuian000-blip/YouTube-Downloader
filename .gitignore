build/
dist/
# The full build variant's own output folders -- build.bat/build.command
# keep the two variants apart so neither clobbers the other's PyInstaller
# cache (see build.spec).
build-full/
dist-full/
__pycache__/
*.pyc
.venv/
venv/

# Bundled binaries -- fetched fresh by CI (see .github/workflows/build.yml),
# kept locally by hand per README.md. Do not commit these.
# Windows names:
ffmpeg.exe
ffprobe.exe
ffplay.exe
deno.exe
# macOS/Linux names (no extension):
/ffmpeg
/ffprobe
/ffplay
/deno
